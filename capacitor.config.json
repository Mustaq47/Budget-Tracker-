{
  "appId": "com.budtrack.app",
  "appName": "BudTrack",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "android": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 1500,
      "backgroundColor": "#080d17",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#080d17"
    },
    "GoogleAuth": {
      "scopes": ["profile", "email"],
      "serverClientId": "322273012281-be2d9feb1b3712e6903be8.apps.googleusercontent.com",
      "forceCodeForRefreshToken": true
    }
  }
}
