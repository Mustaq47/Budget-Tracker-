# Firebase SDK Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Security & Domain Restrictions
VITE_RECAPTCHA_V3_SITE_KEY=your_recaptcha_key
VITE_GOOGLE_HD_DOMAIN=your_domain.com

# Google Authentication Web Client ID (Required for Capacitor Native Google Sign-In on Android/iOS)
# Found in Firebase Console -> Authentication -> Sign-in method -> Google -> Web SDK configuration -> Web client ID
VITE_GOOGLE_CLIENT_ID=322273012281-your_client_id_hash.apps.googleusercontent.com
