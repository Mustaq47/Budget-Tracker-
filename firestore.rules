rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to verify authenticated user ownership
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Helper function to check if user is root super admin or has a SUPER_ADMIN IAM role
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.email == "mustaqsk47@gmail.com" ||
        get(/databases/$(database)/documents/iam_roles/$(request.auth.token.email)).data.role == "SUPER_ADMIN"
      );
    }

    // Helper function to check if user has ANY admin role
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == "mustaqsk47@gmail.com" ||
        exists(/databases/$(database)/documents/iam_roles/$(request.auth.token.email))
      );
    }

    // Helper function to validate backup payload schema & size limits
    function isValidBackupPayload() {
      let data = request.resource.data;
      return request.resource.size < 1 * 1024 * 1024
        && data.keys().hasOnly(['dailyBudget', 'transactions', 'cards', 'goals', 'checksum', 'updatedAt', 'updatedAtFormatted'])
        && data.dailyBudget is number
        && data.transactions is list
        && data.cards is list
        && data.goals is list;
    }

    // Admin IAM roles collection
    match /iam_roles/{assignmentId} {
      allow read: if request.auth != null;
      allow create, update: if isSuperAdmin() && (
        request.resource.data.role != 'SUPER_ADMIN' || 
        request.auth.token.email == "mustaqsk47@gmail.com"
      );
      allow delete: if isSuperAdmin() && (
        resource.data.role != 'SUPER_ADMIN' || 
        request.auth.token.email == "mustaqsk47@gmail.com"
      );
    }

    // Support queries collection
    match /support_queries/{ticketId} {
      allow create: if true;
      allow read, update, delete: if isAdmin() || (request.auth != null && request.auth.token.email == resource.data.userEmail);
    }

    // Revenue collection
    match /revenue/{document=**} {
      allow read, write: if isAdmin();
    }

    // Secure user isolation rules with schema validation
    match /users/{userId}/backups/latest {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }

    // Allow users and admins to read/write parent user profile document
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Allow admins to query/list all user documents
    match /users/{document=**} {
      allow read, write: if isAdmin();
    }

    // Root admin fallback for any collection
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
